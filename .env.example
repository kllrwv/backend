DATABASE_URL=postgres://killerwave:killerwave-local@127.0.0.1:55433/killerwave
APP_ORIGIN=http://localhost:3000
API_BIND=127.0.0.1:18080
# openssl rand -hex 32
APP_SECRET=
# Generate a separate value with openssl rand -hex 32.
CONTACT_SECRET=
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_MODE=plain
SMTP_FROM=access@killerwave.local
SMTP_USER=
SMTP_PASSWORD=
# token from botfather. the backend resolves the username using getMe.
TELEGRAM_BOT_TOKEN=
# Private Telegram forum supergroup where the bot can manage topics.
TELEGRAM_SUPPORT_CHAT_ID=
# Optional separate admin group. Audit delivery uses forum topic 6.
TELEGRAM_ADMIN_CHAT_ID=
# Existing, active account UUID for the initial owner. Remove after first bootstrap.
ADMIN_BOOTSTRAP_ACCOUNT_ID=
ADMIN_ORIGIN=
ADMIN_OPS_DIR=
# BotFather mini app → Login Widget → OpenID Connect Login. Add APP_ORIGIN to Allowed URLs.
TELEGRAM_LOGIN_CLIENT_ID=
# Optional override for the JSON file shared by the site, bot and email.
LOCALIZATIONS_PATH=
# Private S3 bucket with access to objects under media/. Keep these values server-side.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=

# Production compose password. Use a random hexadecimal value.
KW_POSTGRES_PASSWORD=
